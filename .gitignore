node_modules/
*.log
.DS_Store
dist/
__pycache__/
traces/
shaders/
benchmarks/

# Local capture/intermediate output from visual and foliage experiments.
tmp/

# Agent worktrees (Claude Code scratch copies of the tree)
.claude/worktrees/

# Blender/DCC source assets for the tree bake pipeline. These are BUILD INPUTS for
# scripts/build_bk_tree.py and friends, not runtime assets: the game loads the baked
# public/assets/trees/*.glb + impostor atlases. Keeping the ~1.7 GB of .blend/.bin
# sources out of git keeps the repo clonable. Provenance for each source (BlenderKit
# id, licence, download date) is recorded in docs/*-provenance.md so a bake can be
# reproduced from the documented input.
public/assets/trees_src/

# Offline capture output from scripts/shot.mjs — debug artifacts, not sources.
shots/

# Persistent local Course Creator proposal threads, captures, and semantic history.
.course-builder/
